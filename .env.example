# Copy to .env and adjust; docker compose reads it automatically.

# Password for the bundled PostgreSQL. Use letters, digits, - and _ only,
# because it is also placed in a connection URL.
POSTGRES_PASSWORD=change-me

# The server (what the Mac app connects to) is on http://localhost:8080 by default.
NEXTLET_PORT=8080

# Port for the web app, which runs with: docker compose --profile web up -d
NEXTLET_WEB_PORT=8081

# 127.0.0.1 keeps Nextlet private to this machine. Use 0.0.0.0 to reach it from
# other devices (for example the Mac app on another computer). Set
# NEXTLET_PASSWORD first if you do.
NEXTLET_BIND=127.0.0.1

# When set, the web app and the Mac app ask for this password. Leave empty for
# no sign-in. Changing it signs everyone out.
NEXTLET_PASSWORD=

# Optional extra secret mixed into session signatures (any long random string).
SESSION_SECRET=

# true loads a week of sample tasks the first time the database starts empty.
SEED_DEMO=false

LOG_LEVEL=info
